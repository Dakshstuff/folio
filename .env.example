# Folio — Appwrite Cloud configuration (server-side only!)
#
# Copy to `.env` and fill in real values:  cp .env.example .env && chmod 600 .env
# Used ONLY by backend/setup_database.py and backend/create_user.py on the
# administrator's machine. NEVER ship these values to the browser / frontend,
# and never commit `.env`.

APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
# Secret server key.
# setup_database.py scopes: databases.read databases.write collections.read
#   collections.write attributes.read attributes.write indexes.read
#   indexes.write buckets.read buckets.write teams.read teams.write
#   projects.write (optional, for the auto localhost platform)
# create_user.py scopes:   users.read users.write teams.read teams.write
#   databases.read documents.write
APPWRITE_API_KEY=replace-me-secret-server-key
APPWRITE_DATABASE_ID=folio

# --- optional overrides (defaults shown) -------------------------------------
# APPWRITE_BUCKET_ID=resources
# APPWRITE_MAX_FILE_SIZE_MB=25
# APPWRITE_PROFILES_COLLECTION_ID=profiles
# APPWRITE_SUBJECTS_COLLECTION_ID=subjects
# APPWRITE_DOCUMENTS_COLLECTION_ID=documents
# APPWRITE_VERSIONS_COLLECTION_ID=document_versions
# APPWRITE_STARRED_COLLECTION_ID=starred
# APPWRITE_ADMIN_TEAM_ID=admins
# APPWRITE_VIEWER_TEAM_ID=viewers
